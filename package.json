{
  "name": "neon-sigils",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cyberpunk ASCII tech-logo guessing game.",
  "license": "MIT",
  "homepage": "https://neonsigils.cybrsmr.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/atahan99/NeonSigils.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fetch-icons": "tsx scripts/fetch-icons.ts",
    "generate-ascii": "tsx scripts/generate-ascii.ts",
    "validate-logos": "tsx scripts/validate-logo-data.ts",
    "assets": "npm run fetch-icons && npm run generate-ascii && npm run validate-logos",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "simple-icons": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
