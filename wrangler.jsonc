{
  "name": "neonsigils",
  "compatibility_date": "2026-09-23",
  // Build before every deploy/upload so dist/ exists even when the dashboard
  // has no build command configured.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "neonsigils.cybrsmr.xyz",
      "custom_domain": true
    }
  ]
}
